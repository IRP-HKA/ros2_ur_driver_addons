<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tcp_dyn_state_broadcaster</name>
  <version>1.0.0</version>
  <description>This package provides a ROS2 controller, which broadcasts the current dynamic state (velocity and acceleration) of the end-effector of a UR robot.</description>
  <maintainer email="dominik.werman@h-ka.de">Dominik Werman</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/IRP-HKA/ur_driver_addons</url>
  <author email="dominik.werman@h-ka.de">Dominik Werman</author>

  <depend>rclcpp</depend>
  <depend>controller_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>generate_parameter_library</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/tcp_dyn_state_broadcaster_plugin.xml"/>
  </export>
</package>
